---
import ClaudeLayout from '../../layouts/ClaudeLayout.astro';
import template from '../../design/claude/evento.html?raw';
import {publicData,contentDay} from '../../lib/data';
import {artistProfiles,upcomingEvents,shortTime,type ArtistProfile} from '../../lib/artists';
import {escapeHTML,weekday} from '../../lib/presentation';

export function getStaticPaths(){return artistProfiles.map(profile=>({params:{slug:profile.slug},props:{profile}}));}
interface Props {profile:ArtistProfile}
const {profile}=Astro.props;
const artist=publicData.artists.find(a=>a.artist_id===profile.artistId)!;
const name=escapeHTML(artist.artist_name);
const events=upcomingEvents(profile.artistId,contentDay);
const next=events[0];
const day=(d:string)=>`${weekday(d)}, ${d.slice(6,8)}/${d.slice(4,6)}`;
const price=(p:string)=>escapeHTML(p.replace(/\s+por pessoa$/i,''));
const photo=profile.photo;

// Mesmo cabeçalho, rodapé e linguagem visual da página de evento (src/design/claude/evento.html).
const start=template.indexOf('<main>');const end=template.indexOf('</main>');
if(start<0||end<0)throw new Error('Modelo evento.html sem <main>.');

const when=next?`<div class="gap-[20px]" style="background:var(--color-palco);color:#fff;padding:28px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr))" data-responsive-grid>
   <div><div class="tag" style="opacity:.75">Quando</div><div class="mt-[6px]" style="font-weight:700;font-size:20px">${day(next.calendar_date)}</div></div>
   <div><div class="tag" style="opacity:.75">Horário</div><div class="mt-[6px]" style="font-weight:700;font-size:20px">${shortTime(next.calendar_time)}</div></div>
   <div><div class="tag" style="opacity:.75">Couvert</div><div class="mt-[6px]" style="font-weight:700;font-size:20px">${price(next.calendar_price)}</div></div>
  </div>
  <div class="acts"><a class="btn palco" href="https://usetag.me/cafecomletras">Reservar mesa para esta noite</a><a class="btn" href="/programacao/">Ver a programação</a></div>`
 :`<div style="border:1.5px solid var(--color-palco);padding:18px 20px"><strong>Sem datas marcadas no momento.</strong><br><span style="font-size:14px;color:var(--color-text-muted)">Acompanhe a programação do Café com Letras.</span></div>
  <div class="acts"><a class="btn palco" href="/programacao/">Ver a programação</a></div>`;

const more=events.length>1?`<div><div class="tag" style="margin-bottom:6px">Próximas datas</div>${events.map(e=>`<div class="row"><div><div class="n">${day(e.calendar_date)}</div><div class="d">${shortTime(e.calendar_time)}</div></div><div class="pr">${price(e.calendar_price)}</div></div>`).join('')}</div>`:'';

const main=`<main>
<div class="wrap" style="padding-top:24px;padding-bottom:24px;font-size:14px;color:var(--color-text-muted)"><a href="/programacao/">Programação</a> / ${escapeHTML(profile.kind)} / ${name}</div>
<section class="wrap" style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:56px;padding-bottom:96px" data-responsive-grid>
 <img src="${photo.src}" srcset="${photo.small} 440w, ${photo.src} ${photo.width}w" sizes="(max-width:900px) 100vw, 640px" width="${photo.width}" height="${photo.height}" alt="${escapeHTML(photo.alt)}" decoding="async" fetchpriority="high" style="display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:${photo.position};background:var(--color-palco-photo)">
 <div class="flex flex-col gap-[28px]">
  <div><div class="tag" style="color:var(--color-palco)">${escapeHTML(profile.kind)} · ${escapeHTML(profile.genres)}</div><h1 class="disp" style="font-size:84px;margin-top:14px">${name}</h1></div>
  ${when}
  <div><div class="tag" style="margin-bottom:10px">Sobre</div><div class="p">${artist.artist_release}</div></div>
  ${more}
 </div>
</section>
</main>`;
const html=template.slice(0,start)+main+template.slice(end+'</main>'.length);
const description=`${artist.artist_name} no Café com Letras Savassi: ${profile.genres}.${next?` Próxima apresentação: ${day(next.calendar_date)}, ${shortTime(next.calendar_time)}.`:''}`;
---
<ClaudeLayout custom={{key:'artista',title:artist.artist_name,description,path:`/artistas/${profile.slug}/`,html}} />
