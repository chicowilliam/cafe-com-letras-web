---
import {reservationUrl} from '../config/visit';
import {legalReview} from '../config/institutional';
import {pages,production,publicData} from '../lib/data';
import {bhNow,pickHome,renderStage,renderWeek,renderMobileStage,renderMobileWeek,homeSignature,renderV2Date,renderV2Stage,renderV2Week} from '../lib/home-stage';
import {agoraBH} from '../lib/almoco';
import almocoClient from '../client/almoco?worker&url';
import {renderSugestaoHome,renderSugestaoSecao,renderV2Sugestao,sugestaoSignature,sugestaoVigente,type Sugestao} from '../lib/sugestao';
import sugestaoData from '../data/sugestao-do-chef.json';
import {seoFor} from '../lib/seo';
import SiteFooter from '../components/SiteFooter.astro';
import Visit from '../components/Visit.astro';
import HomeExhibitions from '../components/HomeExhibitions.astro';
import FAQ from '../components/FAQ.astro';
import '../styles/institutional.css';
import {whatsapp,type WhatsAppContext} from '../config/whatsapp';
import SiteHeader from '../components/SiteHeader.astro';
import WhatsAppContact from '../components/WhatsAppContact.astro';
import '../styles/site.css';
import homeRaw from '../design/v2/index.html?raw';
import v2Styles from '../design/v2/styles.css?url';
import gastronomia from '../design/v2/gastronomia.html?raw';
import programacao from '../design/v2/programacao.html?raw';
import evento from '../design/claude/evento.html?raw';
import livraria from '../design/v2/livraria.html?raw';
import casa from '../design/v2/casa.html?raw';
import celularRaw from '../design/claude/celular.html?raw';
// custom: página gerada a partir dos dados (ex.: /artistas/<slug>/), com o mesmo cabeçalho, estilos e scripts.
interface Custom {key:string;title:string;description:string;path:string;html:string}
interface Props {name?:string;custom?:Custom;documentTitle?:string}
const {name='index',custom,documentTitle}=Astro.props;
const titles:Record<string,WhatsAppContext>={index:'Home',gastronomia:'Gastronomia',programacao:'Programação',evento:'Evento',livraria:'Livraria',casa:'A Casa',celular:'Home no celular'};
const descriptions:Record<string,string>={index:'Café com Letras Savassi, em Belo Horizonte. Restaurante, café, jazz club e livraria. Cardápio, programação e informações da casa.',gastronomia:'Gastronomia do Café com Letras Savassi: cardápio, almoço executivo, sugestões do chef, bar e vinhos.',programacao:'Programação cultural do Café com Letras Savassi: música, jazz, DJs, livros e exposições em Belo Horizonte.',evento:'Nova Onda: Matheus Avelar Quarteto no Café com Letras Savassi. Informações do modelo de evento da proposta visual.',livraria:'Livraria do Café com Letras Savassi: lançamentos, encontros e clubes de leitura.',casa:'Conheça o Café com Letras Savassi: história, endereço, horários de visita e eventos privados.',celular:'Café com Letras Savassi: gastronomia, programação cultural e informações da casa no celular.'};
// Home: destaque do dia e semana calculados no build; o navegador recalcula na virada do dia (src/client/home.ts).
const homeState=pickHome(publicData.events,process.env.CONTENT_DATE?{day:process.env.CONTENT_DATE,minutes:0}:bhNow());
const homeArtists=new Map(publicData.artists.map(a=>[a.artist_id,a]));
const homeSlots:Record<string,()=>string>={stage:()=>renderStage(homeState,homeArtists),week:()=>renderWeek(homeState,homeArtists),mstage:()=>renderMobileStage(homeState,homeArtists),mweek:()=>renderMobileWeek(homeState,homeArtists),v2date:()=>renderV2Date(homeState),v2stage:()=>renderV2Stage(homeState,homeArtists),v2week:()=>renderV2Week(homeState,homeArtists)};
const homeSig=homeSignature(homeState);
const dynamicHome=(html:string)=>html.replace(/<!--home:(\w+)-->[\s\S]*?<!--\/home:\1-->/g,(match,key:string)=>homeSlots[key]?.()??match).replace(/data-home="(\w+)"/g,`data-home="$1" data-home-sig="${homeSig}"`);
// Sugestão do chef: só aparece no período de validade; o navegador a retira quando vence (src/client/almoco.ts).
const sugestao=sugestaoVigente(sugestaoData as Sugestao,process.env.CONTENT_DATE??agoraBH().day);
const sugestaoSlots:Record<string,()=>string>={secao:()=>renderSugestaoSecao(sugestao),home:()=>renderSugestaoHome(sugestao),mobile:()=>renderSugestaoHome(sugestao,true)};
const sugestaoSig=sugestaoSignature(sugestao);
const dynamicSugestao=(html:string)=>html.replace(/<!--sugestao:(\w+)-->[\s\S]*?<!--\/sugestao:\1-->/g,(match,key:string)=>sugestaoSlots[key]?.()??match).replace(/data-sugestao="(\w+)"/g,`data-sugestao="$1" data-sugestao-sig="${sugestaoSig}"`);
const mesa=(html:string)=>dynamicSugestao(html).replace('<!--almoco:v2home--><!--/almoco:v2home-->',renderV2Sugestao(sugestao));
const home=mesa(dynamicHome(homeRaw));
const v2Home=name==='index'&&!custom&&!documentTitle;
const v2Casa=name==='casa'&&!custom&&!documentTitle;
const v2Design=!documentTitle&&(custom?.key.startsWith('artista')||(!custom&&['index','casa','gastronomia','livraria','programacao'].includes(name)));
const celular=mesa(dynamicHome(celularRaw));
const gastronomiaPage=mesa(gastronomia);
const content:Record<string,string>={index:home,gastronomia:gastronomiaPage,programacao,evento,livraria,casa,celular};
const title='Café com Letras · '+(documentTitle??custom?.title??titles[name]);
const description=documentTitle??custom?.description??descriptions[name];
const canonical='https://cafecomletras.com.br'+(custom?custom.path:['index','celular'].includes(name)?'/':'/'+name+'/');
const base=pages.find(p=>p.key==='savassi-desktop')!;
// Somente entidades institucionais verificadas; não gerar Event para o modelo estático.
const graph=seoFor(base).schema['@graph'].filter(x=>x['@type']!=='Event'&&x['@type']!=='WebPage');
graph.push({'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:'pt-BR',isPartOf:{'@id':'https://cafecomletras.com.br/#website'}});
const schema=JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c');
const instituteName='Instituto Cidades Criativas';
const instituteUrl='http://cidadescriativas.org.br/site/';
const instituteDescription='Instituto que realiza o Savassi Festival.';
const adaptBase=(html:string)=>(production&&!legalReview.approved?html.replace(/<a href="\/(?:politica-de-privacidade|politica-de-cookies|termos-de-uso)\/">[^<]*<\/a>/g,'<span>Documentação de privacidade em revisão</span>'):html).replaceAll('__INSTITUTE_URL__',instituteUrl).replaceAll('__INSTITUTE_NAME__',instituteName).replaceAll('__INSTITUTE_DESCRIPTION__',instituteDescription).replaceAll('__WHATSAPP__',`https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.message)}`).replace(/href="[^"]*"(?=>Compartilhar<)/g, 'href="https://api.whatsapp.com/send?text='+encodeURIComponent('Matheus Avelar Quarteto · 25/11/2026, 20h — https://cafecomletras.com.br/evento/')+'"').replace(/>WhatsApp<\/a>/g,'><img src="/svg/whatsapp-institutional.svg" width="18" height="18" alt="" aria-hidden="true">WhatsApp</a>');
const adapt=(html:string)=>adaptBase(html).replace('<main>','<main id="main-content" tabindex="-1">');
const [homeBeforeExhibitions,homeAfterExhibitions]=adapt(home).split('<!--official-exhibitions-->');
if (homeAfterExhibitions===undefined) throw new Error('Home V2: ponto de montagem de Exposições ausente.');
const [homeBeforeVisit,homeAfterVisit]=homeAfterExhibitions.split('<!--official-visit-->');
const [casaBeforeVisit,casaAfterVisit]=adapt(casa).split('<!--official-visit-->');
if (casaAfterVisit===undefined) throw new Error('Casa V2: ponto de montagem de Visite ausente.');
const [casaBeforeFAQ,casaAfterFAQ]=casaAfterVisit.split('<!--official-faq-->');
---
<!doctype html>
<html lang="pt-BR">
 <head>
  {!custom&&!documentTitle&&['index','gastronomia','celular'].includes(name)&&<script is:inline src={almocoClient} defer {...{blocking:"render"}}></script>}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={production&&!documentTitle&&!['celular','evento'].includes(name)?'index, follow, max-image-preview:large':'noindex, nofollow'} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" /><meta property="og:site_name" content="Café com Letras" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://cafecomletras.com.br/img/share/cafe-com-letras.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/img/common/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&amp;family=Source+Serif+4:ital,wght@0,400;0,600;1,400&amp;display=swap" />
  {v2Design&&<link rel="stylesheet" href={v2Styles} />}
  <script type="application/ld+json" set:html={schema} />
 </head>
 <body class="w-full min-w-0" data-design="claude" data-v2={v2Design?true:undefined} data-page={custom?.key??name}>
  <a class="skip-link" data-skip-content href={documentTitle?'#conteudo':name==='celular'?'#mobile-content':'#main-content'}>Pular para o conteúdo</a>

  <SiteHeader v2={v2Design} page={custom?.key??(name==='celular'?'index':name)} />
  {!documentTitle&&!custom&&name==='celular'&&
   <nav class="home-quick-links" aria-label="Planeje sua visita">
    <div class="wrap">
     <a class="btn palco home-quick-primary" href="/programacao/">Programação</a>
     <a class="btn home-quick-secondary" href="/gastronomia/#cardapio">Cardápio</a>
     <a class="btn home-quick-secondary" href={reservationUrl} target="_blank" rel="noopener noreferrer">Reservar mesa</a>
    </div>
   </nav>
  }
  {documentTitle?<main id="conteudo"><slot/></main>
   :custom?<Fragment set:html={adapt(custom.html)} />
   :v2Home?<><Fragment set:html={homeBeforeExhibitions}/><HomeExhibitions/><Fragment set:html={homeBeforeVisit}/><Visit v2/><Fragment set:html={homeAfterVisit}/></>
   :v2Casa?<><Fragment set:html={casaBeforeVisit}/><Visit v2/><Fragment set:html={casaBeforeFAQ}/><FAQ v2/><Fragment set:html={casaAfterFAQ}/></>
   :<Fragment set:html={adapt(content[name] ?? home)} />}
  {!documentTitle&&!v2Casa&&<>{!v2Home&&<Visit/>}<FAQ/></>}
  <SiteFooter hasVisit={!documentTitle} v2={v2Design}/>
  <WhatsAppContact context={custom||documentTitle?undefined:titles[name]} />
  <script>import '../client/interactions';</script>
 </body>
</html>

