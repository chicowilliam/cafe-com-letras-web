---
import fs from 'node:fs';
import {whatsappUrl} from '../config/whatsapp';
import {seoFor} from '../lib/seo';
import {pages} from '../lib/data';
const {name='index'}=Astro.props;
let html=fs.readFileSync(new URL('../design/'+name+'.html',import.meta.url),'utf8');
html=html.replaceAll('assets/','/claude-assets/').replaceAll('https://wa.me/5531984244285',whatsappUrl.replaceAll('&','&amp;'));
for(const page of ['index','gastronomia','programacao','evento','livraria','casa','celular'])html=html.replaceAll(page+'.html',page==='index'?'/':page==='celular'?'/':'/'+page+'/');
// Demonstration controls remain visibly identified and cannot collect personal data.
html=html.replace(/<form\b[^>]*>/g,'$&<p role="note" class="mono">Demonstração: envio ainda indisponível.</p>').replace(/<(input|textarea|button)\b/g,'<$1 disabled title="Demonstração — indisponível"');
html=html.replace(/<a\b([^>]*href="#(?:delivery-ifood|pt|en|imprensa|trabalhe|lembrete|calendario)?"[^>]*)>/g,'<a $1 aria-disabled="true" tabindex="-1" title="Demonstração — indisponível" style="pointer-events:none">');
const head=html.match(/<head>([\s\S]*?)<\/head>/)![1];
const body=html.match(/<body[^>]*>([\s\S]*?)<\/body>/)![1];
const old=seoFor(pages.find(p=>p.key==='savassi-desktop')!);
const canonical='https://cafecomletras.com.br'+(name==='index'?'/':'/'+name+'/');
const schema={'@context':'https://schema.org','@graph':old.schema['@graph'].filter((x:any)=>x['@type']!=='Event'&&x['@type']!=='WebPage')};
---
<!doctype html>
<html lang="pt-BR"><head><Fragment set:html={head}/><meta name="description" content={old.description}/><meta name="robots" content="noindex, nofollow"/><link rel="canonical" href={canonical}/><link rel="icon" href="/img/common/favicon.ico"/><meta property="og:title" content={'Café com Letras · '+name}/><meta property="og:description" content={old.description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://cafecomletras.com.br/img/share/cafe-com-letras.jpg"/><meta property="og:type" content="website"/><script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\u003c')}/></head><body><Fragment set:html={body}/></body></html>
