---
import {legalReview} from '../config/institutional';
import {pages,production,publicData} from '../lib/data';
import {bhNow,pickHome,renderStage,renderWeek,renderMobileStage,renderMobileWeek,homeSignature} from '../lib/home-stage';
import {seoFor} from '../lib/seo';
import InstitutionalSupport from '../components/InstitutionalSupport.astro';
import FAQ from '../components/FAQ.astro';
import Newsletter from '../components/Newsletter.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/institutional.css';
import {whatsapp,whatsappMessage,type WhatsAppContext} from '../config/whatsapp';
import MobileHeader from '../components/MobileHeader.astro';
import WhatsAppContact from '../components/WhatsAppContact.astro';
import '../styles/site.css';
import homeRaw from '../design/claude/index.html?raw';
import gastronomia from '../design/claude/gastronomia.html?raw';
import programacao from '../design/claude/programacao.html?raw';
import evento from '../design/claude/evento.html?raw';
import livraria from '../design/claude/livraria.html?raw';
import casa from '../design/claude/casa.html?raw';
import celularRaw from '../design/claude/celular.html?raw';
// custom: página gerada a partir dos dados (ex.: /artistas/<slug>/), com o mesmo cabeçalho, estilos e scripts.
interface Custom {key:string;title:string;description:string;path:string;html:string}
interface Props {name?:string;custom?:Custom;documentTitle?:string}
const {name='index',custom,documentTitle}=Astro.props;
const titles:Record<string,WhatsAppContext>={index:'Home',gastronomia:'Gastronomia',programacao:'Programação',evento:'Evento',livraria:'Livraria',casa:'A Casa',celular:'Home no celular'};
const descriptions:Record<string,string>={index:'Café com Letras Savassi, em Belo Horizonte. Restaurante, café, jazz club e livraria. Cardápio, programação e informações da casa.',gastronomia:'Gastronomia do Café com Letras Savassi: cardápio, almoço executivo, sugestões do chef, bar e vinhos.',programacao:'Programação cultural do Café com Letras Savassi: música, jazz, DJs, livros e exposições em Belo Horizonte.',evento:'Nova Onda: Matheus Avelar Quarteto no Café com Letras Savassi. Informações do modelo de evento da proposta visual.',livraria:'Livraria do Café com Letras Savassi: lançamentos, encontros e clubes de leitura.',casa:'Conheça o Café com Letras Savassi: história, endereço, horários de visita e eventos privados.',celular:'Café com Letras Savassi: gastronomia, programação cultural e informações da casa no celular.'};
// Home: destaque do dia e semana calculados no build; o navegador recalcula na virada do dia (src/client/home.ts).
const homeState=pickHome(publicData.events,process.env.CONTENT_DATE?{day:process.env.CONTENT_DATE,minutes:0}:bhNow());
const homeArtists=new Map(publicData.artists.map(a=>[a.artist_id,a]));
const homeSlots:Record<string,()=>string>={stage:()=>renderStage(homeState,homeArtists),week:()=>renderWeek(homeState,homeArtists),mstage:()=>renderMobileStage(homeState,homeArtists),mweek:()=>renderMobileWeek(homeState,homeArtists)};
const homeSig=homeSignature(homeState);
const dynamicHome=(html:string)=>html.replace(/<!--home:(\w+)-->[\s\S]*?<!--\/home:\1-->/g,(match,key:string)=>homeSlots[key]?.()??match).replace(/data-home="(\w+)"/g,`data-home="$1" data-home-sig="${homeSig}"`);
const home=dynamicHome(homeRaw).replace(/<section class="wrap" style="padding-top:80px;padding-bottom:80px;display:grid;grid-template-columns:[^"]+" data-responsive-grid>[\s\S]*?<\/section>/,'');
const celular=dynamicHome(celularRaw);
const content:Record<string,string>={index:home,gastronomia,programacao,evento,livraria,casa,celular};
const title='Café com Letras · '+(documentTitle??custom?.title??titles[name]);
const description=documentTitle??custom?.description??descriptions[name];
const canonical='https://cafecomletras.com.br'+(custom?custom.path:['index','celular'].includes(name)?'/':'/'+name+'/');
const base=pages.find(p=>p.key==='savassi-desktop')!;
// Somente entidades institucionais verificadas; não gerar Event para o modelo estático.
const graph=seoFor(base).schema['@graph'].filter(x=>x['@type']!=='Event'&&x['@type']!=='WebPage');
graph.push({'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:'pt-BR',isPartOf:{'@id':'https://cafecomletras.com.br/#website'}});
const schema=JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c');
const instituteName='Instituto Cidades Criativas';
const instituteUrl='http://cidadescriativas.org.br/site/';
const instituteDescription='Instituto que realiza o Savassi Festival.';
const instituteLink=`<a href="${instituteUrl}" target="_blank" rel="noopener noreferrer">${instituteName}</a>`;
const instituteFooter=`${instituteLink}<br><span>${instituteDescription}</span>`;
const adaptBase=(html:string)=>(production&&!legalReview.approved?html.replace(/<a href="\/(?:politica-de-privacidade|politica-de-cookies|termos-de-uso)\/">[^<]*<\/a>/g,'<span>Documentação de privacidade em revisão</span>'):html).replaceAll('__INSTITUTE_URL__',instituteUrl).replaceAll('__INSTITUTE_NAME__',instituteName).replaceAll('__INSTITUTE_DESCRIPTION__',instituteDescription).replaceAll('__INSTITUTE_FOOTER__',instituteFooter).replaceAll('__WHATSAPP__',`https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.message)}`).replace(/href="[^"]*"(?=>Compartilhar<)/g, 'href="https://api.whatsapp.com/send?text='+encodeURIComponent('Matheus Avelar Quarteto · 25/11/2026, 20h — https://cafecomletras.com.br/evento/')+'"').replace(/>WhatsApp<\/a>/g,'><img src="/svg/whatsapp-institutional.svg" width="18" height="18" alt="" aria-hidden="true">WhatsApp</a>');
const adapt=(html:string)=>adaptBase(html).replace(/<footer class="foot">[\s\S]*?<\/footer>/g,'').replace(/<section class="mobile-footer"[\s\S]*?<\/section>/g,'').replace(/<span><a href="#pt"[^>]*>PT<\/a>\s*\/\s*<a href="#en"[^>]*>EN<\/a><\/span>/g,'').replace(/<a\b[^>]*href="(#trabalhe|#imprensa)"[^>]*>/g,(tag,destination)=>{
 const context=destination==='#trabalhe'?'Trabalhe conosco':'Imprensa';
 return tag.replace(/href="[^"]*"/,`href="https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsappMessage(context))}"`).replace(/ (?:data-demo|aria-disabled|title)="[^"]*"/g,'');
}).replace('<main>','<main id="main-content" tabindex="-1">').replace(/<nav class="nav"[^>]*>[\s\S]*?<\/nav>/g,nav=>nav.replace(/(<a\b[^>]*class="[^" ]*\bon\b[^"]*")/g,'$1 aria-current="page"'));
---
<!doctype html>
<html lang="pt-BR">
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={production&&!documentTitle&&!['celular','evento'].includes(name)?'index, follow, max-image-preview:large':'noindex, nofollow'} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" /><meta property="og:site_name" content="Café com Letras" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://cafecomletras.com.br/img/share/cafe-com-letras.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/img/common/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&amp;family=Inter:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" />
  <script type="application/ld+json" set:html={schema} />
 </head>
 <body class="w-full min-w-0" data-design="claude" data-page={custom?.key??name}>
  <a class:list={["skip-link", {"skip-desktop":name==='index'&&!custom&&!documentTitle}]} data-skip-content href={documentTitle?'#conteudo':name==='celular'?'#mobile-content':'#main-content'}>Pular para o conteúdo</a>
  {name==='index'&&!custom&&!documentTitle&&<a class="skip-link skip-mobile" data-skip-content href="#mobile-content">Pular para o conteúdo</a>}
  {name==='celular'&&<Fragment set:html={adapt(home.split('<main>')[0] ?? '')}/> }
  <MobileHeader page={custom?.key??(name==='celular'?'index':name)} />
  {documentTitle?<><Fragment set:html={adapt(home.split('<main>')[0] ?? '')}/><main id="conteudo"><slot/></main><Fragment set:html={adapt(home.slice(home.indexOf('<footer')))}/></>:custom?<Fragment set:html={adapt(custom.html)} />:name==='index'?<><div class="home-desktop" set:html={adapt(home)} /><div class="home-mobile w-full min-w-0" set:html={adapt(celular)} /></>:<Fragment set:html={adapt(content[name] ?? home)} />}
  {name==='casa'&&<FAQ/>}
  {(name==='index'||name==='casa')&&!custom&&!documentTitle&&<Newsletter/>}
  <SiteFooter/>
  <InstitutionalSupport/>
  <WhatsAppContact context={custom||documentTitle?undefined:titles[name]} />
  <script>import '../client/interactions';</script>
 </body>
</html>

