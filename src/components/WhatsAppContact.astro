---
import {whatsapp,whatsappMessage,type WhatsAppContext} from '../config/whatsapp';
interface Props { context?: WhatsAppContext }
const {context}=Astro.props;
const message=whatsappMessage(context);
const href=`https://wa.me/${whatsapp.number}?text=${encodeURIComponent(message)}`;
---
<a class="whatsapp-contact" href={href} target="_blank" rel="noopener noreferrer" aria-label="Conversar com o Café com Letras pelo WhatsApp (abre em nova aba)">
 <span class="whatsapp-mark" aria-hidden="true"></span>
 <span class="whatsapp-label">WhatsApp</span>
</a>
<style>
 .whatsapp-contact {
  position: fixed;
  right: max(16px, calc(env(safe-area-inset-right) + 8px));
  bottom: calc(16px + env(safe-area-inset-bottom));
  z-index: 25;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  box-sizing: border-box;
  min-width: 54px;
  min-height: 54px;
  padding: 0 15px;
  border: 1px solid #fff;
  border-radius: 12px;
  box-shadow: 0 3px 12px rgb(22 22 20 / .18);
  background: #08794c;
  color: #fff;
  font: 600 14px/1.2 var(--font-body, system-ui, sans-serif);
  text-decoration: none;
  transition: background-color 150ms ease, transform 150ms ease;
 }
 .whatsapp-mark {
  width: 25px;
  height: 25px;
  flex: none;
  background: currentColor;
  /* WhatsApp brand artwork, hosted locally. Use its silhouette on the button. */
  mask: url('/svg/whatsapp-brand.svg') center / contain no-repeat;
 }
 .whatsapp-contact:focus-visible { outline: 3px solid #08794c; outline-offset: 3px; }
 .whatsapp-contact:active { transform: scale(.96); }
 @media (hover: hover) { .whatsapp-contact:hover { background: #07613e; opacity: 1; } }
 @media (max-width: 900px) {
  .whatsapp-label { display: none; }
  .whatsapp-contact { padding: 0; }
 }
 @media (prefers-reduced-motion: reduce) {
  .whatsapp-contact { transition: none; }
  .whatsapp-contact:active { transform: none; }
 }
</style>
