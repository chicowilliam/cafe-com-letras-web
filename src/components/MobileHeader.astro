---
interface Props { page: string }
const {page}=Astro.props;
const activePage=page==='evento'||page.startsWith('artista')?'programacao':page;
const links=[
 ['/','Início','index'],['/gastronomia/','Gastronomia','gastronomia'],
 ['/programacao/','Programação','programacao'],['/livraria/','Livraria','livraria'],
 ['/programacao/#em-cartaz','Exposições',''],['/casa/','A Casa','casa'],
] as const;
---
<div class="compact-navigation">
 <header class="compact-header">
  <a href="/" aria-label="Café com Letras, página inicial"><img src="/claude/assets/logo-ink.png" alt="Café com Letras" width="373" height="121" /></a>
  <span class="mobile-hours">A partir das 12h</span>
  <button type="button" class="mobile-menu-toggle" data-mobile-menu aria-expanded="false" aria-haspopup="dialog" aria-controls="page-navigation" aria-label="Abrir menu"><svg width="22" height="22" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 14h14"/></svg></button>
 </header>
 <dialog id="page-navigation" class="mobile-navigation" aria-labelledby="mobile-navigation-title">
  <div class="mobile-panel">
   <div class="mobile-panel-heading">
    <h2 id="mobile-navigation-title" class="h3">Menu</h2>
    <button type="button" class="mobile-menu-toggle" data-close-mobile-menu autofocus aria-label="Fechar menu"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15"/></svg></button>
   </div>
   <nav class="mobile-panel-links" aria-label="Principal">
    {links.map(([href,label,key])=><a href={href} aria-current={activePage===key?'page':undefined}>{label}</a>)}
   </nav>
   <nav class="mobile-panel-actions" aria-label="Visita e pedidos">
    <a class="btn ink" href="https://reservation.getin.app/36qBovkN?utm_source=ig&utm_medium=social&utm_content=link_in_bio&fbclid=PAdGRleAVuqRlleHRuA2FlbQIxMQBwZG9mAmZkaWQWUSprkyoRb8PZn_lrfI4UitinV6V4UHNydGMGYXBwX2lkDzEyNDAyNDU3NDI4NzQxNAABp3OtnfkFWrddmH6vz1lHWFMNHRadofO9_j-0MJiUF2jYwv61asJeZZDc2fT6_aem_9Z7Y5oVvOBGYougNCU8vKg" target="_blank" rel="noopener noreferrer">Reservar</a>
    <a class="btn" href="/delivery/">Delivery</a>
    <a class="mobile-directions" href="/casa/#visite">Como chegar</a>
   </nav>
  </div>
 </dialog>
</div>
