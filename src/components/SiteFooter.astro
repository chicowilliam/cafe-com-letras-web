---
import {mapsUrl, reservationUrl} from '../config/visit';
import {whatsapp, whatsappMessage, type WhatsAppContext} from '../config/whatsapp';
import InstitutionalSupport from './InstitutionalSupport.astro';

interface Props { hasVisit: boolean }
const { hasVisit } = Astro.props;

const contact = (context?: WhatsAppContext) =>
 `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsappMessage(context))}`;
---
<footer class="foot site-footer">
 <div class="wrap">
  <div class="footer-grid">
   <div>
    <a class="footer-brand" href="/" aria-label="Café com Letras, página inicial"><img src="/claude/assets/logo-white.png" width="373" height="121" alt="Café com Letras" loading="lazy" /></a>
    <p>Gastronomia, música e literatura na Savassi desde 1996.</p>
   </div>
   <div>
    <h2 class="tag">Fale com a casa</h2>
    <ul>
     <li><a href={contact()}>WhatsApp (31) 98424-4285</a></li>
     <li><a href={reservationUrl} target="_blank" rel="noopener noreferrer">Reservas</a></li>
     <li><a href="https://www.ifood.com.br/delivery/belo-horizonte-mg/cafe-com-letras-savassi/b53324c0-32a8-4278-b229-4b362b7847cc" target="_blank" rel="noopener noreferrer">Delivery</a></li>
    </ul>
    <div class="footer-socials">
     <a class="social-link" href="https://www.instagram.com/cafe_com_letras/" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg><span>Instagram</span></a>
     <a class="social-link" href="https://www.youtube.com/@cafecomletrastv" target="_blank" rel="noopener noreferrer"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z"/></svg><span>YouTube</span></a>
    </div>
   </div>
   <div>
    <h2 class="tag">Da mesma casa</h2>
    <ul>
     <li><a href="https://clubedejazzdocafe.com" target="_blank" rel="noopener noreferrer">Clube de Jazz do Café com Letras</a></li>
     <li><a href="https://www.instagram.com/ototoibardediscos/" target="_blank" rel="noopener noreferrer">Ototoi</a></li>
     <li><a href="https://www.savassifestival.com.br/" target="_blank" rel="noopener noreferrer">Savassi Festival</a></li>
     <li><a href="http://cidadescriativas.org.br/site/" target="_blank" rel="noopener noreferrer">Instituto Cidades Criativas</a></li>
    </ul>
   </div>
   <nav aria-label="Links úteis">
    <h2 class="tag">Links úteis</h2>
    <ul>
     <li><a href={hasVisit ? "#visite" : "/casa/#visite"}>Endereço e horários</a></li>
     <li><a href={mapsUrl} target="_blank" rel="noopener noreferrer">Abrir no Google Maps</a></li>
     <li><a href="/casa/#eventos-privados">Eventos privados</a></li>
     <li><a href={contact('Trabalhe conosco')}>Trabalhe conosco</a></li>
     <li><a href={contact('Imprensa')}>Imprensa</a></li>
    </ul>
   </nav>
  </div>
  <InstitutionalSupport embedded />
 </div>
</footer>
