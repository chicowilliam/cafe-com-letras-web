---
import {reservationUrl} from '../config/visit';

interface Props { page: string; v2?: boolean }
const {page,v2=false}=Astro.props;
const deliveryUrl='https://www.ifood.com.br/delivery/belo-horizonte-mg/cafe-com-letras-savassi/b53324c0-32a8-4278-b229-4b362b7847cc';
const activePage=['evento','festival','exposicao'].includes(page)||page.startsWith('artista')?'programacao':page;
const links=[
 ['/','Início','index','m3 10 9-7 9 7v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 21v-7h6v7'],
 ['/gastronomia/','Gastronomia','gastronomia','M3 3v5a3 3 0 0 0 6 0V3 M6 3v18 M20 3c-3 2-5 5-5 9h5m0-9v18'],
 ['/programacao/','Programação','programacao','M8 2v4m8-4v4 M3 10h18 M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M8 15h2m4 0h2'],
 ['/livraria/','Livraria','livraria','M12 7C9 4 6 4 3 5v13c3-1 6-1 9 2 3-3 6-3 9-2V5c-3-1-6-1-9 2v13'],
 ['/programacao/#em-cartaz','Exposições','','M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M3 16l5-5 4 4 3-3 6 6 M15 8h.01'],
 ['/casa/','A Casa','casa','M3 21h18 M5 21V9l7-6 7 6v12 M10 21v-5h4v5 M9 10h6'],
] as const;
---
{v2 ? <header class="topo"><div class="wrap">
 <a class="marca" href="/" aria-label="Café com Letras, página inicial"><img src="/design-v2/logo-ink.png" alt="Café com Letras" width="148" height="48"/></a>
 <nav class="nav-d" aria-label="Principal">
  {links.slice(1).map(([href,label,key])=><a href={href} aria-current={activePage===key?'page':undefined}>{label}</a>)}
 </nav>
 <a class="link delivery-d" href={deliveryUrl} target="_blank" rel="noopener noreferrer">Delivery</a>
 <a class="btn btn-p" href={reservationUrl} target="_blank" rel="noopener noreferrer">Reservar</a>
 <details class="menu-m">
  <summary><span class="abrir">Menu</span><span class="fechar">Fechar</span></summary>
  <div class="painel">
   <nav aria-label="Principal no celular">
    {links.map(([href,label,key])=><a href={href} aria-current={activePage===key?'page':undefined}>{label}</a>)}
   </nav>
   <div class="acoes">
    <a class="btn" href={reservationUrl} target="_blank" rel="noopener noreferrer">Reservar mesa</a>
    <a class="link" href={deliveryUrl} target="_blank" rel="noopener noreferrer">Delivery</a>
   </div>
   <div class="meta">Rua Antônio de Albuquerque, 781, Savassi</div>
  </div>
 </details>
</div></header> : <>
<div class="site-header" data-site-header>
 <div class="desktop-navigation">
  <div class="util"><div class="wrap"><span><strong>Horários da casa</strong> · a partir das 12h</span><span>Rua Antônio de Albuquerque, 781 · Savassi · Belo Horizonte</span></div></div>
  <header class="hdr"><div class="wrap">
   <a href="/" class="site-logo" aria-label="Café com Letras, página inicial"><img src="/claude/assets/logo-ink.png" width="373" height="121" alt="Café com Letras" /></a>
   <nav class="nav" aria-label="Principal">
    {links.slice(1).map(([href,label,key])=><a href={href} class:list={{on:activePage===key}} aria-current={activePage===key?'page':undefined}>{label}</a>)}
   </nav>
   <div class="acts">
    <a class="btn ink" href={reservationUrl} target="_blank" rel="noopener noreferrer">Reservar</a>
    <a class="btn" href="https://www.ifood.com.br/delivery/belo-horizonte-mg/cafe-com-letras-savassi/b53324c0-32a8-4278-b229-4b362b7847cc" target="_blank" rel="noopener noreferrer">Delivery</a>
   </div>
  </div></header>
 </div>
 <div class="compact-navigation">
 <header class="compact-header">
  <a href="/" aria-label="Café com Letras, página inicial"><img src="/claude/assets/logo-ink.png" alt="Café com Letras" width="373" height="121" /></a>
  <span class="mobile-hours">A partir das 12h</span>
  <button type="button" class="mobile-menu-toggle" data-mobile-menu aria-expanded="false" aria-haspopup="dialog" aria-controls="page-navigation" aria-label="Abrir menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
 </header>
 </div>
</div>
 <dialog id="page-navigation" class="mobile-navigation" aria-labelledby="mobile-navigation-title">
  <div class="mobile-panel">
   <div class="mobile-panel-heading">
    <h2 id="mobile-navigation-title" class="h3">Menu</h2>
    <button type="button" class="mobile-menu-toggle mobile-panel-close" data-close-mobile-menu autofocus aria-label="Fechar menu"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
   </div>
   <nav class="mobile-panel-links" aria-label="Principal">
    {links.map(([href,label,key,icon])=>
     <a href={href} aria-current={activePage===key?'page':undefined}>
      <svg class="mobile-panel-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon}/></svg>
      <span>{label}</span>
     </a>
    )}
   </nav>
   <nav class="mobile-panel-actions" aria-label="Visita e pedidos">
    <a class="btn ink" href={reservationUrl} target="_blank" rel="noopener noreferrer">Reservar</a>
    <a class="btn" href="https://www.ifood.com.br/delivery/belo-horizonte-mg/cafe-com-letras-savassi/b53324c0-32a8-4278-b229-4b362b7847cc" target="_blank" rel="noopener noreferrer">Delivery</a>
    <a class="mobile-directions" href="/casa/#visite">
     <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="2.5"/></svg>
     Como chegar
    </a>
   </nav>
  </div>
 </dialog>
</>}
