---
import {reservationUrl} from '../config/visit';
import {whatsapp} from '../config/whatsapp';

const whatsappLink = `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.message)}`;
interface Props { page: string }
const {page}=Astro.props;
const activePage=['evento','festival'].includes(page)||page.startsWith('artista')?'programacao':page;
const links=[
 ['/','Início','index'],['/gastronomia/','Gastronomia','gastronomia'],
 ['/programacao/','Programação','programacao'],['/livraria/','Livraria','livraria'],
 ['/programacao/#em-cartaz','Exposições',''],['/casa/','A Casa','casa'],
] as const;
---
<div class="site-header" data-site-header>
 <div class="desktop-navigation">
  <div class="util"><div class="wrap"><span><strong>Horários da casa</strong> · a partir das 12h</span><span>Rua Antônio de Albuquerque, 781 · Savassi · Belo Horizonte</span></div></div>
  <header class="hdr"><div class="wrap">
   <a href="/" class="site-logo" aria-label="Café com Letras, página inicial"><img src="/claude/assets/logo-ink.png" width="373" height="121" alt="Café com Letras" /></a>
   <nav class="nav" aria-label="Principal">
    {links.slice(1).map(([href,label,key])=><a href={href} class:list={{on:activePage===key}} aria-current={activePage===key?'page':undefined}>{label}</a>)}
   </nav>
   <div class="acts">
    <a class="btn ink" href={reservationUrl} target="_blank" rel="noopener noreferrer">Reservar</a>
    <a class="btn" href="/delivery/">Delivery</a>
    <a class="btn" href={whatsappLink}><img src="/svg/whatsapp-institutional.svg" width="18" height="18" alt="" aria-hidden="true" />WhatsApp</a>
   </div>
  </div></header>
 </div>
 <div class="compact-navigation">
 <header class="compact-header">
  <a href="/" aria-label="Café com Letras, página inicial"><img src="/claude/assets/logo-ink.png" alt="Café com Letras" width="373" height="121" /></a>
  <span class="mobile-hours">A partir das 12h</span>
  <button type="button" class="mobile-menu-toggle" data-mobile-menu aria-expanded="false" aria-haspopup="dialog" aria-controls="page-navigation" aria-label="Abrir menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
 </header>
 </div>
</div>
 <dialog id="page-navigation" class="mobile-navigation" aria-labelledby="mobile-navigation-title">
  <div class="mobile-panel">
   <div class="mobile-panel-heading">
    <h2 id="mobile-navigation-title" class="h3">Menu</h2>
    <button type="button" class="mobile-menu-toggle" data-close-mobile-menu autofocus aria-label="Fechar menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
   </div>
   <nav class="mobile-panel-links" aria-label="Principal">
    {links.map(([href,label,key])=><a href={href} aria-current={activePage===key?'page':undefined}>{label}</a>)}
   </nav>
   <nav class="mobile-panel-actions" aria-label="Visita e pedidos">
    <a class="btn ink" href={reservationUrl} target="_blank" rel="noopener noreferrer">Reservar</a>
    <a class="btn" href="/delivery/">Delivery</a>
    <a class="mobile-directions" href="/casa/#visite">Como chegar</a>
   </nav>
  </div>
 </dialog>
